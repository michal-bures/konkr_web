// Cloudflare Workers static assets: the built site, deployed by .github/workflows/deploy-cloudflare.yml
{
    "name": "konkr",
    "compatibility_date": "2026-10-28",
    "assets": {
        "directory": "./_site",
        // paths without a file get 404.html with a 404 status: a missing script or image must fail, or a service worker
        // caches the game page in its place. The game's deep links get their page from rewrites in _redirects
        "not_found_handling": "404-page"
    }
}
